{
  "name": "workstation_quality_first",
  "vad": {
    "runtime": "sherpa-onnx",
    "model_id": "silero-vad",
    "device": "cpu",
    "options": {"sample_rate": 16000, "endpointing": true}
  },
  "asr": {
    "runtime": "FunASR",
    "model_id": "FunAudioLLM/SenseVoiceSmall",
    "device": "cuda",
    "options": {"languages": ["zh", "yue", "en", "ja", "ko"], "hotwords": true}
  },
  "llm": {
    "runtime": "llama.cpp_or_vllm",
    "model_id": "Qwen/Qwen3-4B-Instruct-2507",
    "device": "cuda",
    "endpoint": "http://127.0.0.1:8080",
    "options": {"temperature": 0, "reasoning": false, "structured_tools": true}
  },
  "tts": {
    "runtime": "sherpa-onnx",
    "model_id": "vits-melo-tts-zh_en",
    "device": "cpu",
    "options": {"optional": true}
  }
}
