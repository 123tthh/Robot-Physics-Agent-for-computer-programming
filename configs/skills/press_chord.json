{
  "name": "press_chord",
  "version": "0.4.0",
  "arguments": {
    "keys": ["ctrl", "alt", "t"]
  },
  "preconditions": [
    "work_pose_ready",
    "keyboard_calibrated",
    "target_keys_reachable",
    "screen_visible"
  ],
  "resources": [
    "left_arm",
    "right_arm",
    "left_dex3",
    "right_dex3",
    "keyboard",
    "keyboard_camera"
  ],
  "controller": {
    "type": "modular_action_graph",
    "contract_version": "1.0.0",
    "compiler": "keyboard_action_compiler",
    "modules": [
      "bimanual_prepose@1.1.0",
      "key_prepose@1.0.0",
      "key_down@1.1.0",
      "key_up@1.0.1",
      "modifier_release_group@1.0.0",
      "screen_gate@1.0.0"
    ]
  },
  "local_postconditions": [
    "commanded_keys_pressed",
    "fingers_released"
  ],
  "next_skill_readiness": [
    "terminal_ready"
  ],
  "failure_codes": [
    "ALT_MISSED",
    "UNREACHABLE_KEY",
    "MISSED_CONTACT",
    "ADJACENT_KEY_CONTACT",
    "FORCE_LIMIT",
    "MISSED_EVENT",
    "INSUFFICIENT_TRAVEL",
    "DUPLICATE_EVENT",
    "MISSING_KEYUP",
    "WRONG_KEY",
    "STUCK_MODIFIER",
    "HAND_COLLISION_RISK",
    "TERMINAL_NOT_FOCUSED"
  ],
  "recoveries": [
    "recalibrate_keyboard",
    "restore_terminal_focus"
  ]
}
